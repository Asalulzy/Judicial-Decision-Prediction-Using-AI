# Path to dataset zip or extracted folder
DATASET_PATH=D:\\Lomba\\Project RAG\\dataset.zip

# Where to store built vectorstore (directory)
VECTORSTORE_DIR=vectorstore/faiss_index

# Embedding model (sentence-transformers or HF)
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# LLM backend: 'hf' or 'ollama'
LLM_BACKEND=hf

# If using Ollama, point to the base URL, e.g. http://localhost:11434
OLLAMA_URL=

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5
